{
    "name": "iecep-lsc/memsys",
    "description": "IECEP-LSC MEMSYS - PWA for Membership Management",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0",
        "endroid/qr-code": "^5.0",
        "bacon/bacon-qr-code": "^3.0",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "firebase/php-jwt": "^6.11",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.9",
        "phpoffice/phpspreadsheet": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "optimize-autoloader": true,
        "allow-plugins": {
            "*": true
        },
        "audit": {
            "block": false,
            "abandoned": "ignore"
        },
        "platform": {
            "php": "8.2.0"
        }
    }
}
